<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vento.Sharing.Desktop.ViewModels"
        x:Class="Vento.Sharing.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Width="960" Height="600" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppRail}"
        Title="Vento Sharing · Entrar">
    <Grid x:Name="LoginRootGrid" ColumnDefinitions="*,380" RowDefinitions="*"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid x:Name="LoginLeftHost" Grid.Column="0" Grid.Row="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ScrollViewer x:Name="LoginFormScroll" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="LoginFormCenterHost" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="LoginFormPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="48,32" Spacing="16" MaxWidth="480" MinWidth="280">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AppAccent}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="V" FontSize="28" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Bem-vindo de volta!" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource AppText}" />
                        <TextBlock Text="Estamos muito animados em te ver novamente."
                                   FontSize="15" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" />

                        <TextBlock Text="E-mail ou usuário" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,0"
                                   FontSize="12" FontWeight="Bold" />
                        <TextBox x:Name="IdentifierInput" Text="{Binding Identifier, Mode=TwoWay}"
                                 PlaceholderText="seu_usuario ou voce@exemplo.com" />

                        <TextBlock Text="Senha" Foreground="{DynamicResource AppMuted}" FontSize="12" FontWeight="Bold" />
                        <TextBox x:Name="PasswordInput" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●"
                                 PlaceholderText="Sua senha" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <CheckBox Content="Salvar login neste computador"
                                      IsChecked="{Binding RememberCredentials, Mode=TwoWay}"
                                      Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="link" Content="Esquecer"
                                    Command="{Binding ForgetCredentialsCommand}"
                                    IsVisible="{Binding HasSavedCredentials}" />
                        </Grid>

                        <Button Classes="primary" Content="Entrar" Command="{Binding LoginCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AppWarning}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border x:Name="BrowserPanel" Grid.Column="1" Grid.Row="0"
                Background="{DynamicResource AppBackground}" Padding="32"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel x:Name="BrowserContentPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="14" MaxWidth="320">
                        <TextBlock Text="Conta Vento" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AppMuted}" />
                        <TextBlock Text="Entrar pelo navegador"
                                   FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Use o hub para login ou cadastro. O app recebe a sessão automaticamente."
                                   FontSize="14" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" />

                        <Button Content="Abrir login no navegador" Command="{Binding BrowserLoginCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" />
                        <Button Classes="link" Content="Criar conta" Command="{Binding OpenRegistrationCommand}"
                                HorizontalAlignment="Left" />

                        <Border Height="1" Background="{DynamicResource AppBorder}" Margin="0,16" />

                        <Button Classes="ghost" Content="{Binding ServerSettingsLabel}"
                                Command="{Binding ToggleServerSettingsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="0" Foreground="{DynamicResource AppLink}" />
                        <Border IsVisible="{Binding ShowServerSettings}" Padding="0,8,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="API Vento" Foreground="{DynamicResource AppMuted}" FontSize="12"
                                           FontWeight="Bold" />
                                <TextBox Text="{Binding ServerAddress, Mode=TwoWay}"
                                         PlaceholderText="http://127.0.0.1:5080" />
                                <TextBlock Text="Hub Vento" Foreground="{DynamicResource AppMuted}" FontSize="12"
                                           FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBox Text="{Binding HubAddress, Mode=TwoWay}"
                                         PlaceholderText="http://127.0.0.1:5081" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
