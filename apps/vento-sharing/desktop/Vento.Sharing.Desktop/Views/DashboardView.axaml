<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vento.Sharing.Desktop.ViewModels"
             x:Class="Vento.Sharing.Desktop.Views.DashboardView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackground}">
    <Grid>
    <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" Width="72" Background="{DynamicResource AppRail}" ClipToBounds="False"
                Padding="0,12,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="8" Width="72">
                    <Grid Width="72" Height="48" ColumnDefinitions="4,12,48,8">
                        <Border Grid.Column="0" Width="4" Height="40" CornerRadius="0,3,3,0"
                                VerticalAlignment="Center" Background="White" IsVisible="{Binding IsHome}" />
                        <Button Grid.Column="2" Classes="server" Command="{Binding ShowHomeCommand}"
                                ToolTip.Tip="Início" Background="{DynamicResource AppAccent}">
                            <TextBlock Text="V" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                    <Border Height="2" Width="32" Background="#35363C" HorizontalAlignment="Center" CornerRadius="1" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,8">
                    <StackPanel Spacing="8" Width="72">
                        <ItemsControl ItemsSource="{Binding Rooms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="8" Width="72" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoomTileViewModel">
                                    <Grid Width="72" Height="48" ColumnDefinitions="4,12,48,8">
                                        <Border Grid.Column="0" Width="4" Height="40" CornerRadius="0,3,3,0"
                                                VerticalAlignment="Center" Background="White"
                                                IsVisible="{Binding IsSelected}" />
                                        <Button Grid.Column="2" Classes="server" Command="{Binding OpenCommand}"
                                                ToolTip.Tip="{Binding Title}">
                                            <Border Width="48" Height="48" CornerRadius="24" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold"
                                                               Foreground="#DCDDDE" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" IsVisible="{Binding HasNoImage}" />
                                                    <Image Source="{Binding Image}" IsVisible="{Binding HasImage}"
                                                           Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Width="72" Height="48" ColumnDefinitions="4,12,48,8">
                            <Button Grid.Column="2" Classes="server-add"
                                    Command="{Binding OpenRoomComposerCommand}"
                                    ToolTip.Tip="Criar ou entrar em uma sala" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#232428" Height="56" Width="72"
                        HorizontalAlignment="Center">
                    <Button Classes="ghost" Width="48" Height="48" Padding="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding ToggleProfileCommand}"
                            ToolTip.Tip="{Binding Username, StringFormat='Perfil: {0}'}">
                        <Border Width="48" Height="48" CornerRadius="24" ClipToBounds="True"
                                Background="{DynamicResource AppAccentSoft}">
                            <Grid>
                                <TextBlock Text="{Binding AvatarLetter}" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppText}"
                                           IsVisible="{Binding HasNoAvatarImage}" />
                                <Image Source="{Binding AvatarImage}" IsVisible="{Binding HasAvatarImage}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackground}">
        <Border Grid.Row="0" IsVisible="{Binding IsRoomSelected}" Background="{DynamicResource AppHeader}"
                Height="48" BorderBrush="#111214" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Text="#" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}"
                           VerticalAlignment="Center" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedRoom.Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Classes="ghost" Content="Convite" Click="OnCopyWebRoomLinkClick"
                        VerticalAlignment="Center" Padding="8,4" FontSize="13"
                        Foreground="{DynamicResource AppText}" />
            </Grid>
        </Border>
        <Border Grid.Row="0" IsVisible="{Binding IsHome}" Background="{DynamicResource AppHeader}"
                Height="48" BorderBrush="#111214" BorderThickness="0,0,0,1" Padding="16,0">
            <TextBlock Text="Início" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"
                       VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="0" IsVisible="{Binding IsProfilePage}" Background="{DynamicResource AppHeader}"
                Height="48" BorderBrush="#111214" BorderThickness="0,0,0,1" Padding="16,0">
            <TextBlock Text="Configurações de usuário" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppText}" VerticalAlignment="Center" />
        </Border>
        <ScrollViewer x:Name="MainContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MainContentPanel" Margin="16" Spacing="16" MaxWidth="900">
                <StackPanel IsVisible="{Binding IsHome}" Spacing="20">
                    <TextBlock Text="Suas salas e amigos — escolha uma sala na barra lateral ou crie uma nova."
                               FontSize="14" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"
                               LineHeight="20" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="SALAS ATIVAS" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AppMuted}" LetterSpacing="0.4" />
                        <TextBlock Text="Nenhuma das suas salas tem pessoas conectadas agora."
                                   IsVisible="{Binding HasNoActiveRooms}" Foreground="{DynamicResource AppMuted}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ActiveRooms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoomTileViewModel">
                                    <Button Command="{Binding OpenCommand}" Width="260" Height="196"
                                            Margin="0,0,12,12" Padding="10" Background="{DynamicResource AppSurface}"
                                            CornerRadius="8"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">
                                            <Border Background="{DynamicResource AppBackground}" CornerRadius="9">
                                                <TextBlock Text="Nenhuma transmissão ativa" FontSize="12"
                                                           Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AppText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Text="{Binding OnlineCount, StringFormat='Conectados agora: {0}'}"
                                                       FontSize="12" Foreground="{DynamicResource AppAccent}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="RECENTES" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AppMuted}" LetterSpacing="0.4" Margin="0,8,0,0" />
                        <TextBlock Text="Abra uma sala na sidebar para vê-la aqui."
                                   IsVisible="{Binding HasNoRecentRooms}" Foreground="{DynamicResource AppMuted}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding RecentRooms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoomTileViewModel">
                                    <Button Command="{Binding OpenCommand}" Width="200" Height="72"
                                            Margin="0,0,8,8" Padding="12" Background="{DynamicResource AppSurface}"
                                            CornerRadius="8"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding OnlineCount, StringFormat='Conectados agora: {0}'}"
                                                       FontSize="12" Foreground="{DynamicResource AppMuted}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Amigos" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AppMuted}" LetterSpacing="0.4" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox x:Name="FriendUsernameInput"
                                         Text="{Binding FriendUsernameInput, Mode=TwoWay}"
                                         PlaceholderText="Username do amigo" />
                                <Button Grid.Column="1" Content="Adicionar" Command="{Binding AddFriendCommand}"
                                        Padding="16,8" />
                            </Grid>
                            <TextBlock Text="Você ainda não adicionou amigos."
                                       IsVisible="{Binding HasNoFriends}" Foreground="{DynamicResource AppMuted}" />
                            <ItemsControl ItemsSource="{Binding Friends}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FriendViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AppAccentSoft}">
                                                <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource AppText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Username}" Foreground="{DynamicResource AppText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding FriendMessage}" Foreground="{DynamicResource AppWarning}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsProfilePage}" Spacing="16" MaxWidth="780">
                    <TextBlock Text="Perfil, aparência e dados da conta Vento."
                               Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" />

                    <Border Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Foto do perfil" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}" />
                            <Border Width="92" Height="92" CornerRadius="46"
                                    Background="{DynamicResource AppAccentSoft}" ClipToBounds="True"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <TextBlock Text="{Binding AvatarLetter}" FontSize="34"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppText}"
                                               IsVisible="{Binding HasNoAvatarImage}" />
                                    <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                                           IsVisible="{Binding HasAvatarImage}" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Alterar foto" Click="OnUploadAccountImageClick" />
                                <Button Content="Remover foto" Click="OnRemoveAccountImageClick"
                                        IsVisible="{Binding HasAvatarImage}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ImageMessage}" Foreground="{DynamicResource AppWarning}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="CONTA" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AppMuted}" LetterSpacing="0.4" />
                            <TextBlock Text="Informações da conta" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}" />
                            <TextBlock Text="Nome de usuário" Foreground="{DynamicResource AppMuted}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox x:Name="ProfileUsernameInput"
                                         Text="{Binding EditableUsername, Mode=TwoWay}" MaxLength="32" />
                                <Button Grid.Column="1" Content="Salvar" Command="{Binding SaveUsernameCommand}"
                                        Padding="18,8" />
                            </Grid>
                            <TextBlock Text="3 a 32 caracteres: letras, números, ponto, _ ou -."
                                       FontSize="12" Foreground="{DynamicResource AppMuted}" />
                            <TextBlock Text="E-mail" Foreground="{DynamicResource AppMuted}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Email}" Foreground="{DynamicResource AppText}" />
                            <TextBlock Text="{Binding ProfileMessage}" Foreground="{DynamicResource AppWarning}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="13">
                            <TextBlock Text="APARÊNCIA" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AppMuted}" LetterSpacing="0.4" />
                            <TextBlock Text="Tema do aplicativo" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}" />
                            <TextBlock Text="{Binding SelectedThemeName, StringFormat='Tema atual: {0}'}"
                                       Foreground="{DynamicResource AppMuted}" />
                            <ItemsControl ItemsSource="{Binding ThemeChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeChoiceViewModel">
                                        <Button Command="{Binding SelectCommand}" Width="136" Height="66"
                                                Margin="0,0,10,10" Background="{Binding PreviewBrush}"
                                                BorderBrush="{DynamicResource AppText}" CornerRadius="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="#10131C" TextAlignment="Center" />
                                                <TextBlock Text="Selecionado" FontSize="11" Foreground="#10131C"
                                                           TextAlignment="Center" IsVisible="{Binding IsSelected}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsRoomSelected}" Spacing="12">
                    <TextBlock Text="{Binding SelectedRoom.OnlineCount, StringFormat='{}{0} conectados agora'}"
                               FontSize="13" Foreground="{DynamicResource AppMuted}" />

                    <Border IsVisible="{Binding HasSharedScreen}" Background="#000000" ClipToBounds="True"
                            CornerRadius="8"
                            MinHeight="200" MaxHeight="520">
                        <Image x:Name="SharedVideoImage" Source="{Binding SharedScreenImage}" Stretch="Uniform" />
                    </Border>

                    <Border IsVisible="{Binding ShowLocalSharingStatus}" Background="{DynamicResource AppSurface}"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6" MaxWidth="520">
                            <TextBlock Text="Você está transmitindo" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}" />
                            <TextBlock Text="Os participantes veem sua tela ao vivo. A pré-visualização local não é exibida nesta versão."
                                       Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" LineHeight="20" />
                            <TextBlock Text="{Binding ShareMessage}" Foreground="{DynamicResource AppAccent}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding ShowWaitingForStream}" Background="{DynamicResource AppSurface}"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6" MaxWidth="520">
                            <TextBlock Text="Conectando à transmissão…" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}" />
                            <TextBlock Text="O vídeo aparece aqui assim que os primeiros quadros chegarem."
                                       Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ViewerMessage}" Foreground="{DynamicResource AppWarning}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding ShowIdleStreamPlaceholder}" Background="{DynamicResource AppSurface}"
                            CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="6" MaxWidth="520">
                            <TextBlock Text="Nenhuma tela no ar" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}" />
                            <TextBlock Text="Quando alguém compartilhar, o vídeo surge neste espaço. Use Compartilhar na barra inferior para iniciar."
                                       Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" LineHeight="20" />
                            <TextBlock Text="{Binding ViewerMessage}" Foreground="{DynamicResource AppWarning}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ShareMessage}" Foreground="{DynamicResource AppAccent}"
                                       TextWrapping="Wrap" IsVisible="{Binding HasNoActiveSharer}" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsParticipantsInlineVisible}"
                            Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding ParticipantsCount, StringFormat='MEMBROS — {0}/6'}"
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"
                                       LetterSpacing="0.4" />
                            <TextBlock Text="Ninguém compartilhando" Foreground="{DynamicResource AppMuted}"
                                       IsVisible="{Binding HasNoActiveSharer}" />
                            <ItemsControl ItemsSource="{Binding Participants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoomParticipantViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <TextBlock Text="{Binding Username}" Foreground="{DynamicResource AppText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="Anfitrião" Foreground="{DynamicResource AppWarning}"
                                                           IsVisible="{Binding IsOwner}" />
                                                <TextBlock Text="● Compartilhando" Foreground="{DynamicResource AppAccent}"
                                                           IsVisible="{Binding IsSharing}" />
                                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppMuted}"
                                                           IsVisible="{Binding !IsSharing}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="16"
                            IsVisible="{Binding SelectedRoom.IsOwner}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Configurações da sala" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border Width="72" Height="72" Background="{DynamicResource AppPanel}" CornerRadius="12"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedRoom.Initial}" FontSize="26"
                                                   Foreground="{DynamicResource AppAccent}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" IsVisible="{Binding SelectedRoom.HasNoImage}" />
                                        <Image Source="{Binding SelectedRoom.Image}" Stretch="UniformToFill"
                                               IsVisible="{Binding SelectedRoom.HasImage}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Escolher imagem" Click="OnUploadRoomImageClick"
                                            IsVisible="{Binding SelectedRoom.IsOwner}" HorizontalAlignment="Left" />
                                    <Button Content="Remover imagem" Click="OnRemoveRoomImageClick"
                                            IsVisible="{Binding SelectedRoom.CanRemoveImage}"
                                            Background="Transparent" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="PNG ou JPEG, até 2 MB e 2048 × 2048 pixels."
                                       Foreground="{DynamicResource AppMuted}" FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding SelectedRoom.IsOwner}" />
                            <TextBlock Text="{Binding ImageMessage}" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="CONVITE" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AppMuted}" LetterSpacing="0.4" />
                            <TextBlock Text="Convidar para a sala" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}" />
                            <TextBlock Text="Compartilhe este código para convidar alguém à sala."
                                       Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding SelectedRoom.InviteCode}" IsReadOnly="True"
                                     HorizontalAlignment="Left" MinWidth="180" />
                            <TextBlock Text="Link para assistir pelo navegador" Foreground="{DynamicResource AppMuted}"
                                       Margin="0,8,0,0" />
                            <TextBox Text="{Binding SelectedRoomWebUrl}" IsReadOnly="True"
                                     HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding HubLinkHint}" Foreground="{DynamicResource AppMuted}"
                                       FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Copiar link" Click="OnCopyWebRoomLinkClick" />
                                <Button Content="Abrir no navegador" Command="{Binding OpenWebRoomCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedRoom.ParticipantCount, StringFormat='Participantes: {0}/6'}"
                                       Foreground="{DynamicResource AppMuted}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedRoom.OnlineCount, StringFormat='Conectados agora: {0}'}"
                                       Foreground="{DynamicResource AppAccent}" FontSize="12" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" IsVisible="{Binding IsRoomSelected}" Background="{DynamicResource AppSurface}"
                BorderBrush="#111214" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding ShareMessage}" FontSize="13"
                           Foreground="{DynamicResource AppMuted}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="primary" Command="{Binding StartSharingCommand}"
                            IsVisible="{Binding IsPublisherInactive}" Padding="20,10"
                            ToolTip.Tip="Escolher tela ou janela para compartilhar"
                            Content="Compartilhar tela" />
                    <Button Classes="danger" Command="{Binding StopSharingCommand}"
                            IsVisible="{Binding IsPublisherActive}" Padding="20,10"
                            ToolTip.Tip="Parar ou cancelar transmissão"
                            Content="Desconectar" />
                </StackPanel>
            </Grid>
        </Border>
        </Grid>

        <Border Grid.Column="2" Width="240"
                IsVisible="{Binding IsParticipantsSidebarVisible}" Background="{DynamicResource AppSurface}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">
                <Border Background="{DynamicResource AppHeader}" Height="48" Padding="16,0"
                        BorderBrush="#111214" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding ParticipantsCount, StringFormat='Membros — {0}'}"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"
                               VerticalAlignment="Center" />
                </Border>

                <Border Grid.Row="1" Padding="12,10" Background="{DynamicResource AppSurface}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Transmissão de tela" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AppMuted}" />
                        <TextBlock Text="Ninguém compartilhando" FontSize="13"
                                   Foreground="{DynamicResource AppMuted}" IsVisible="{Binding HasNoActiveSharer}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasActiveSharer}">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AppOnline}" VerticalAlignment="Center" />
                            <TextBlock Text="Ao vivo" FontSize="13" Foreground="{DynamicResource AppOnline}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,0,8,8"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Participants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomParticipantViewModel">
                                <Border Background="Transparent" Padding="8,6" Margin="0,0,0,2" CornerRadius="4">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{DynamicResource AppPanel}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource AppText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" MinWidth="0">
                                            <TextBlock Text="{Binding Username}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AppText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Anfitrião" FontSize="11" Foreground="{DynamicResource AppWarning}"
                                                       IsVisible="{Binding IsOwner}" />
                                            <TextBlock Text="● Compartilhando" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}"
                                                       IsVisible="{Binding IsSharing}" />
                                            <TextBlock Text="{Binding Status}" FontSize="11"
                                                       Foreground="{DynamicResource AppMuted}" IsVisible="{Binding !IsSharing}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>

    <Grid ZIndex="100" IsHitTestVisible="{Binding IsProfileOpen}">
        <Border x:Name="ProfileDismissLayer" IsVisible="{Binding IsProfileOpen}"
                Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                PointerPressed="OnProfileDismissLayerPressed" />

        <Border IsVisible="{Binding IsProfileOpen}" Width="300"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="76,0,0,8" Background="{DynamicResource AppHeader}" CornerRadius="8" Padding="8"
                BorderBrush="#111214" BorderThickness="1">
            <StackPanel Spacing="13">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Seu perfil" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppText}" />
                    <Button Grid.Column="1" Content="✕" Command="{Binding CloseProfileCommand}"
                            Classes="ghost" Foreground="{DynamicResource AppMuted}" Padding="8,2" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="44" Height="44" Background="{DynamicResource AppAccentSoft}"
                            CornerRadius="22" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding AvatarLetter}" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppText}" IsVisible="{Binding HasNoAvatarImage}" />
                            <Image Source="{Binding AvatarImage}" IsVisible="{Binding HasAvatarImage}"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Conta Vento" FontSize="12" Foreground="{DynamicResource AppAccent}" />
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource AppBorder}" />
                <Button Content="Visualizar perfil" Command="{Binding OpenProfilePageCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <StackPanel Spacing="4">
                    <TextBlock Text="E-mail" FontSize="11" Foreground="{DynamicResource AppMuted}" />
                    <TextBlock Text="{Binding Email}" FontSize="13" Foreground="{DynamicResource AppText}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Salas em que participa" FontSize="11" Foreground="{DynamicResource AppMuted}" />
                    <TextBlock Text="{Binding RoomCount}" FontSize="13" Foreground="{DynamicResource AppText}" />
                </StackPanel>
                <Button Content="Sair da conta" Command="{Binding LogoutCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{DynamicResource AppPanel}" Foreground="{DynamicResource AppText}"
                        BorderBrush="{DynamicResource AppBorder}" CornerRadius="9" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>

    <Grid ZIndex="110" IsHitTestVisible="{Binding IsRoomComposerOpen}">
        <Border IsVisible="{Binding IsRoomComposerOpen}"
                Background="#99000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                PointerPressed="OnRoomComposerBackdropPressed" />

        <Border x:Name="RoomComposerModal" IsVisible="{Binding IsRoomComposerOpen}"
                Width="{Binding ComposerWidth}" MaxHeight="{Binding ComposerMaxHeight}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Criar ou entrar em uma sala" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppText}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="✕" Command="{Binding CloseRoomComposerCommand}"
                                    Background="Transparent" Foreground="{DynamicResource AppMuted}" />
                        </Grid>
                        <TextBlock Text="Nova sala" Foreground="{DynamicResource AppMuted}" FontWeight="SemiBold" />
                        <TextBox x:Name="RoomNameInput" Text="{Binding NewRoomName, Mode=TwoWay}"
                                 PlaceholderText="Nome da sala" MaxLength="80" />
                        <Button Classes="primary" Content="Criar sala" Command="{Binding CreateRoomCommand}"
                                HorizontalAlignment="Left" />
                        <Border Height="1" Background="{DynamicResource AppBorder}" Margin="0,8" />
                        <TextBlock Text="Entrar por convite" Foreground="{DynamicResource AppMuted}" FontWeight="SemiBold" />
                        <TextBox x:Name="InviteCodeInput" Text="{Binding InviteCodeInput, Mode=TwoWay}"
                                 PlaceholderText="Código de 10 caracteres" MaxLength="10" />
                        <Button Content="Entrar na sala" Command="{Binding JoinRoomCommand}"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" />
                    </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
</UserControl>
